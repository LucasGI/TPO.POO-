@startuml clases-final-modelo
' TPO POO - Rumbo Sur - Diagrama de clases final (Etapa 2) - paquete modelo
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3B5B85
  ArrowColor #3B5B85
}
hide empty members

package "modelo" {
  abstract class Persona <<Serializable>> {
    - nombre : String
    - apellido : String
    - documento : String
    - telefono : String
    + getNombreCompleto() : String
  }
  class Cliente {
    - email : String
    - paisResidencia : String
  }
  abstract class Empleado {
    - legajo : int
    + {abstract} getRol() : String
  }
  class Vendedor {
    - comision : double
    + calcularComision(ventas : double) : double
    + getRol() : String
  }
  class Guia {
    - idiomas : List<String>
    - categorias : List<Categoria>
    - honorarioDiario : double
    + habilitarCategoria(c : Categoria) : void
    + puedeGuiar(t : Tour) : boolean
    + estaDisponible(desde : LocalDate, hasta : LocalDate, salidas : List<Salida>) : boolean
    + getRol() : String
  }
  class Coordinador {
    + getRol() : String
  }
  class Administrador {
    + getRol() : String
  }
  Persona <|-- Cliente
  Persona <|-- Empleado
  Empleado <|-- Vendedor
  Empleado <|-- Guia
  Empleado <|-- Coordinador
  Empleado <|-- Administrador

  abstract class Tour <<Serializable>> {
    - codigo : String
    - nombre : String
    - descripcion : String
    - duracionDias : int
    - cupoMinimo : int
    - cupoMaximo : int
    + {abstract} getCategoria() : Categoria
    + validarPasajero(p : Pasajero, fecha : LocalDate) : void
    + validar() : void
    + serviciosObligatorios() : List<ServicioAdicional>
    + tarifaVigente(fecha : LocalDate) : Tarifa
    + agregarActividad(dia, orden, horario, descripcion, lugar, proveedor) : void
    + agregarTarifa(t : Tarifa) : void
    + agregarServicio(s : ServicioAdicional) : void
    + buscarServicio(codigo : String) : ServicioAdicional
    + crearSalida(id : int, fecha : LocalDate, cupo : int) : Salida
  }
  class TourAventura {
    - nivelDificultad : String
    - edadMinima : int
    + getCategoria() : Categoria
    + validarPasajero(p : Pasajero, fecha : LocalDate) : void
    + validar() : void
    + serviciosObligatorios() : List<ServicioAdicional>
  }
  class TourCultural {
    + getCategoria() : Categoria
  }
  class TourNaturaleza {
    + getCategoria() : Categoria
  }
  Tour <|-- TourAventura
  Tour <|-- TourCultural
  Tour <|-- TourNaturaleza

  class Actividad <<Comparable>> {
    - dia : int
    - orden : int
    - horario : String
    - descripcion : String
    - lugar : String
    + compareTo(o : Actividad) : int
  }
  class Proveedor {
    - nombre : String
    - cuit : String
    - contacto : String
    - servicio : TipoServicio
  }
  class Tarifa {
    - temporada : Temporada
    - vigenciaDesde : LocalDate
    - vigenciaHasta : LocalDate
    - precioBase : double
    + vigenteEn(fecha : LocalDate) : boolean
    + seSuperponeCon(t : Tarifa) : boolean
  }
  class ServicioAdicional {
    - codigo : String
    - nombre : String
    - precio : double
    - tipo : TipoServicio
    - obligatorio : boolean
  }
  Tour *-- "1..*" Actividad : itinerario
  Actividad --> "0..1" Proveedor
  Tour *-- "1..*" Tarifa
  Tour o-- "0..*" ServicioAdicional

  class Salida <<Comparable>> {
    - id : int
    - fechaInicio : LocalDate
    - fechaFin : LocalDate
    - cupoMaximo : int
    - estado : EstadoSalida
    - listaEmitida : boolean
    + reservar(numero, hoy, titular, vendedor, datos : List<DatosPasajero>) : Reserva
    + verificarLugarPara(cantidad : int) : void
    + lugaresOcupados() : int
    + lugaresDisponibles() : int
    + liberarLugares(r : Reserva) : void
    + actualizarEstado() : void
    + diasHasta(hoy : LocalDate) : long
    + asignarGuia(g : Guia, todas : List<Salida>) : void
    + asignarVehiculo(v : Vehiculo) : void
    + emitirListaPasajeros() : List<Pasajero>
    + iniciar() : void
    + finalizar(hoy : LocalDate) : Liquidacion
    + cancelar(motivo, hoy, pol : PoliticaCancelacion) : List<Cancelacion>
    + ventasAdicionales() : double
    + compareTo(o : Salida) : int
  }
  class Vehiculo {
    - patente : String
    - capacidad : int
    - tipo : TipoVehiculo
  }
  Salida --> "1" Tour
  Salida --> "0..1" Guia
  Salida --> "0..1" Vehiculo
  Salida o-- "0..*" Reserva
  Salida *-- "0..1" Liquidacion

  class Reserva {
    - numero : int
    - fecha : LocalDate
    - estado : EstadoReserva
    - total : double
    + agregarPasajero(d : DatosPasajero) : Pasajero
    + reemplazarPasajero(doc : String, d : DatosPasajero, hoy : LocalDate) : void
    + agregarAdicional(p : Pasajero, s : ServicioAdicional) : void
    + registrarPago(importe, medio : MedioPago, cuotas, hoy) : Pago
    + cancelar(motivo, hoy, pol : PoliticaCancelacion) : Cancelacion
    + actualizarTotal(total, hoy, detalle) : void
    + cantidadLugares() : int
    + totalPagado() : double
    + saldo() : double
    + montoSenia() : double
    + totalAdicionales() : double
  }
  class DatosPasajero {
    - nombre, apellido, documento : String
    - fechaNacimiento : LocalDate
    - jubilado : boolean
    - codigosAdicionales : List<String>
  }
  class Pasajero <<Comparable>> {
    - nombre : String
    - apellido : String
    - documento : String
    - fechaNacimiento : LocalDate
    - jubilado : boolean
    - contactoEmergencia : String
    - restricciones : String
    + edadEn(fecha : LocalDate) : int
    + tipoEn(fecha : LocalDate) : TipoPasajero
    + totalAdicionales() : double
    + compareTo(o : Pasajero) : int
  }
  class Pago {
    - fecha : LocalDate
    - importe : double
    - recargo : double
    - medio : MedioPago
    - cuotas : int
    + getTotalCobrado() : double
  }
  class Cancelacion {
    - fecha : LocalDate
    - motivo : String
    - porAgencia : boolean
    - importeDevuelto : double
    - medio : MedioPago
  }
  class NotaAjuste {
    - fecha : LocalDate
    - importe : double
    - detalle : String
  }
  class Liquidacion {
    - fecha : LocalDate
    - diasTrabajados : int
    - montoFijo : double
    - montoAdicionales : double
    + total() : double
  }
  Reserva --> "1" Cliente : titular
  Reserva --> "1" Vendedor
  Reserva --> "1" Salida
  Reserva *-- "1..*" Pasajero
  Pasajero o-- "0..*" ServicioAdicional : adicionales
  Reserva *-- "0..*" Pago
  Reserva *-- "0..1" Cancelacion
  Reserva *-- "0..*" NotaAjuste
  Liquidacion --> "1" Guia
  Reserva ..> DatosPasajero : crea Pasajero con

  enum TipoPasajero {
    INFANTE(0.0)
    MENOR(0.6)
    ADULTO(1.0)
    + getFactor() : double
  }
  enum EstadoSalida {
    PROGRAMADA
    CONFIRMADA
    COMPLETA
    EN_CURSO
    FINALIZADA
    CANCELADA
    + puedePasarA(e : EstadoSalida) : boolean
    + admiteReservas() : boolean
  }
  enum EstadoReserva {
    PENDIENTE
    CONFIRMADA
    ANULADA
    FINALIZADA
  }
  enum MedioPago {
    EFECTIVO
    TRANSFERENCIA
    TARJETA
  }
  enum Categoria {
    AVENTURA
    CULTURAL
    NATURALEZA
  }
  enum Temporada {
    BAJA
    MEDIA
    ALTA
  }
  enum TipoServicio {
    EXCURSION
    TRASLADO
    SEGURO
    ALOJAMIENTO
    COMIDA
  }
  enum TipoVehiculo {
    COMBI
    MINIBUS
    COLECTIVO
  }
}
@enduml
