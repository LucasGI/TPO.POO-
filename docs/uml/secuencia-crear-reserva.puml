@startuml secuencia-crear-reserva
' TPO POO - Rumbo Sur - CU05 Crear reserva
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam sequence {
  ParticipantBorderColor #3B5B85
  LifeLineBorderColor #8AA1C1
  ArrowColor #3B5B85
}
autonumber
actor Vendedor
participant ":PanelReservas" as UI
participant ":ReservaController" as RC
participant ":SalidaRepositorio" as SRepo
participant ":ClienteRepositorio" as CRepo
participant ":EmpleadoRepositorio" as ERepo
participant "s:Salida" as S
participant "t:Tour" as T
participant "r:Reserva" as R
participant "p:Pasajero" as P
participant ":CalculadoraPrecio" as CALC
participant "promo:Promocion" as PROMO
participant ":ReservaRepositorio" as RRepo

Vendedor -> UI : presiona "Crear reserva" y completa\nsalida, titular, vendedor y cada pasajero
activate UI
UI -> RC : crearReserva(idSalida, docCliente, legajo, datos, hoy)
activate RC
RC -> SRepo : buscarPorId(idSalida)
SRepo --> RC : s
RC -> CRepo : buscarPorId(docCliente)
CRepo --> RC : cliente
RC -> ERepo : buscarPorId(legajo)
ERepo --> RC : vendedor
RC -> S : reservar(numero, hoy, cliente, vendedor, datos)
activate S

alt estado no admite reservas (completa, en curso, finalizada, cancelada) o lugaresDisponibles() < datos.size()
  S --> RC : throw CupoInsuficienteException
  RC --> UI : throw CupoInsuficienteException
  UI --> Vendedor : JOptionPane: "No hay lugares suficientes"
else hay cupo
  S -> R ** : new Reserva(numero, hoy, cliente, vendedor, s)
  loop para cada DatosPasajero d
    S -> R : agregarPasajero(d)
    activate R
    R -> P ** : new Pasajero(d)
    R -> T : validarPasajero(p, fechaInicio)
    activate T
    alt pasajero no cumple condiciones (edad mínima en aventura)
      T --> R : throw PasajeroInvalidoException
      R --> S : throw PasajeroInvalidoException
      S --> RC : throw PasajeroInvalidoException
      RC --> UI : throw PasajeroInvalidoException
      UI --> Vendedor : JOptionPane: el motivo del rechazo
    end
    deactivate T
    loop para cada servicio en t.serviciosObligatorios()
      R -> R : agregarAdicional(p, servicio)
    end
    deactivate R
  end
  S -> S : reservas.add(r) y actualizarEstado()
  note right of S : si lugaresOcupados() >= cupoMinimo → CONFIRMADA\nsi lugaresOcupados() == cupoMaximo → COMPLETA
  S --> RC : r
  deactivate S

  opt el pasajero eligio adicionales (codigosAdicionales)
    loop para cada adicional elegido
      RC -> R : agregarAdicional(p, servicio)
    end
  end

  RC -> CALC : calcularTotal(r)
  activate CALC
  CALC -> T : tarifaVigente(fechaInicio)
  T --> CALC : tarifa
  loop para cada pasajero
    CALC -> P : tipoEn(fechaInicio)
    P --> CALC : TipoPasajero
  end
  loop para cada promoción
    CALC -> PROMO : aplica(r)
    PROMO --> CALC : boolean
  end
  CALC -> CALC : mejorDescuento(r) + totalAdicionales()
  CALC --> RC : total
  deactivate CALC
  RC -> R : actualizarTotal(total, hoy, "Alta de reserva")
  RC -> RRepo : guardar(r)
  RC -> SRepo : guardar(s)
  RC --> UI : r
  deactivate RC
  UI --> Vendedor : JOptionPane: número, total y seña (30 %)
end
deactivate UI
@enduml
