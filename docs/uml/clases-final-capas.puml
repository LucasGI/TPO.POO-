@startuml clases-final-capas
' TPO POO - Rumbo Sur - Diagrama de clases final (Etapa 2) - vista, controladores, servicios y persistencia
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3B5B85
  ArrowColor #3B5B85
}
hide empty members
top to bottom direction

package "app" {
  class Main {
    + main(args : String[]) : void
  }
  class DatosDePrueba {
    + cargar(hoy : LocalDate) : void
  }
}

package "vista" {
  class VentanaPrincipal <<JFrame>> {
    + VentanaPrincipal(archivo, base, controladores...)
  }
  abstract class PanelBase <<JPanel, ActionListener>> {
    # ventana : JFrame
    # areaResultado : JTextArea
    # agregarBoton(texto) : JButton
    + actionPerformed(e : ActionEvent) : void
    # {abstract} procesar(fuente : Object) : void
    # mostrar(lineas : List<String>) : void
    # mostrarError(mensaje) : void
  }
  class Formulario <<JDialog>> {
    + agregarTexto(etiqueta) : void
    + agregarOpciones(etiqueta, opciones : String[]) : void
    + agregarCasilla(etiqueta) : void
    + mostrar() : boolean
    + texto(etiqueta) : String
    + entero(etiqueta) : int
    + decimal(etiqueta) : double
    + fecha(etiqueta) : LocalDate
    + opcion(etiqueta) : int
    + marcado(etiqueta) : boolean
  }
  class PanelReservas
  class PanelSalidas
  class PanelCatalogo
  class PanelReportes
  PanelBase <|-- PanelReservas
  PanelBase <|-- PanelSalidas
  PanelBase <|-- PanelCatalogo
  PanelBase <|-- PanelReportes
  VentanaPrincipal *-- PanelReservas
  VentanaPrincipal *-- PanelSalidas
  VentanaPrincipal *-- PanelCatalogo
  VentanaPrincipal *-- PanelReportes
  PanelBase ..> Formulario : abre
}

package "controlador" {
  class ReservaController <<GRASP Controlador>> {
    + crearReserva(idSalida, docCliente, legajo, datos, hoy) : Reserva
    + registrarPago(nro, importe, medio, cuotas, hoy) : Pago
    + agregarPasajero(nro, datos, hoy) : Reserva
    + reemplazarPasajero(nro, docSale, nuevo, hoy) : Reserva
    + contratarAdicional(nro, docPasajero, codigo, hoy) : Reserva
    + cancelarReserva(nro, motivo, porAgencia, hoy) : Cancelacion
  }
  class SalidaController <<GRASP Controlador>> {
    + programarSalida(codTour, fecha, cupo, hoy) : Salida
    + asignarGuia(idSalida, legajo) : Salida
    + asignarVehiculo(idSalida, patente) : Salida
    + emitirListaPasajeros(idSalida) : List<String>
    + iniciarSalida(idSalida) : Salida
    + cerrarSalida(idSalida, hoy) : Liquidacion
    + cancelarSalida(idSalida, motivo, hoy) : List<Cancelacion>
    + controlarVencimientos(hoy) : List<String>
  }
  class CatalogoController <<GRASP Controlador>> {
    + altaTour(t : Tour) : void
    + agregarTarifa(codTour, t : Tarifa) : void
    + registrarCliente(c : Cliente) : void
    + registrarEmpleado(e : Empleado) : void
    + registrarVehiculo(v : Vehiculo) : void
    + registrarProveedor(p : Proveedor) : void
  }
  class ReporteController <<GRASP Controlador>> {
    + ocupacionPorSalida() : List<String>
    + ventasPorVendedor() : List<String>
    + ingresosPorTour() : List<String>
    + cancelaciones() : List<String>
    + liquidaciones() : List<String>
  }
}

package "servicio" {
  class CalculadoraPrecio <<GRASP Fabricacion pura>> {
    - promociones : List<Promocion>
    + calcularTotal(r : Reserva) : double
    + precioPasajero(p, base, fecha) : double
    + mejorDescuento(r : Reserva) : double
  }
  interface Promocion {
    + aplica(r : Reserva) : boolean
    + porcentaje() : double
    + getNombre() : String
  }
  class PromocionAnticipada
  class PromocionGrupo
  interface PoliticaCancelacion {
    + porcentajeDevolucion(diasAntes : long) : double
    + esCancelacionDeAgencia() : boolean
  }
  class PoliticaCancelacionCliente
  class PoliticaCancelacionAgencia
  class LineaReporte {
    - texto : String
    - valor : double
  }
  class ComparadorPorValor <<Comparator>>
  class ComparadorCancelacionPorFecha <<Comparator>>
  Promocion <|.. PromocionAnticipada
  Promocion <|.. PromocionGrupo
  PoliticaCancelacion <|.. PoliticaCancelacionCliente
  PoliticaCancelacion <|.. PoliticaCancelacionAgencia
  CalculadoraPrecio o-- "0..*" Promocion
  ComparadorPorValor ..> LineaReporte
}

package "persistencia" {
  interface "Repositorio<T, ID>" as Repositorio {
    + guardar(e : T) : void
    + buscarPorId(id : ID) : T
    + listar() : List<T>
    + cantidad() : int
  }
  abstract class "RepositorioLista<T, ID>" as RepositorioLista {
    # elementos : List<T>
    # {abstract} obtenerId(e : T) : ID
  }
  class TourRepositorio
  class SalidaRepositorio
  class ClienteRepositorio
  class ReservaRepositorio
  class EmpleadoRepositorio
  class VehiculoRepositorio
  class ProveedorRepositorio
  class BaseDatos <<Serializable>>
  class ArchivoDatos {
    - ruta : String
    + guardar(b : BaseDatos) : void
    + cargar() : BaseDatos
    + existe() : boolean
  }
  class ArchivoTexto {
    - carpeta : String
    + escribir(nombre, lineas : List<String>) : String
  }
  Repositorio <|.. RepositorioLista
  RepositorioLista <|-- TourRepositorio
  RepositorioLista <|-- SalidaRepositorio
  RepositorioLista <|-- ClienteRepositorio
  RepositorioLista <|-- ReservaRepositorio
  RepositorioLista <|-- EmpleadoRepositorio
  RepositorioLista <|-- VehiculoRepositorio
  RepositorioLista <|-- ProveedorRepositorio
  BaseDatos *-- TourRepositorio
  BaseDatos *-- SalidaRepositorio
  BaseDatos *-- ClienteRepositorio
  BaseDatos *-- ReservaRepositorio
  BaseDatos *-- EmpleadoRepositorio
  BaseDatos *-- VehiculoRepositorio
  BaseDatos *-- ProveedorRepositorio
  ArchivoDatos ..> BaseDatos : serializa
}

package "excepcion" {
  class ReglaNegocioException
  class CupoInsuficienteException
  class EstadoInvalidoException
  class AsignacionInvalidaException
  class PagoInvalidoException
  class PasajeroInvalidoException
  ReglaNegocioException <|-- CupoInsuficienteException
  ReglaNegocioException <|-- EstadoInvalidoException
  ReglaNegocioException <|-- AsignacionInvalidaException
  ReglaNegocioException <|-- PagoInvalidoException
  ReglaNegocioException <|-- PasajeroInvalidoException
}

Main ..> ArchivoDatos
Main ..> DatosDePrueba
Main ..> VentanaPrincipal
PanelReservas --> ReservaController
PanelSalidas --> SalidaController
PanelCatalogo --> CatalogoController
PanelReportes --> ReporteController
ReservaController --> Repositorio : usa (DIP)
SalidaController --> Repositorio : usa (DIP)
CatalogoController --> Repositorio : usa (DIP)
ReporteController --> Repositorio : usa (DIP)
ReservaController --> CalculadoraPrecio
ReservaController ..> PoliticaCancelacion
SalidaController --> ArchivoTexto
ReporteController --> ArchivoTexto
ReporteController ..> ComparadorPorValor
ReporteController ..> ComparadorCancelacionPorFecha
@enduml
